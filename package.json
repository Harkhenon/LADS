{
  "name": "lads",
  "version": "0.4.1",
  "description": "Application locale pour les animations de chant",
  "author": "Harkhenon <isoka33@gmail.com>",
  "license": "MIT",
  "homepage": "https://harkhenon.dev",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "npm run lint && npm test",
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build -c vite.server.config.mjs",
    "package": "node scripts/package-release.mjs",
    "release": "node scripts/release.mjs",
    "release:sign": "node scripts/sign-release.mjs",
    "release:keygen": "node scripts/generate-update-key.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@mantine/core": "^9.7.5",
    "@mantine/form": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@mantine/notifications": "^9.7.5",
    "@tabler/icons-react": "^3.50.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass-embedded": "^1.107.1",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module"
}
